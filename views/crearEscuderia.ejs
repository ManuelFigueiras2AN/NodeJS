<%- include ("templates/cabecera", {tituloWeb: 'Cargar Escuderias' }) %>

    <div class="container" >
        <h1 class="mt-5">Cargar Escuderia</h1>

        <form action="/escuderias" method="POST">  

            <input type="text" class="form-control mb-2" placeholder="Nombre de la escuderia" name="nombre">
            <input type="text" class="form-control mb-2" placeholder="Pais de la escuderia" name="pais">
            <input type="number" class="form-control mb-2" placeholder="Cantidad de campeonatos" name="campeonatos">
            <button type="submit" class="btn btn-success m-2">Cargar</button>
            <button type="reset" class="btn btn-danger m-2">Limpiar</button>
            <button type="button" class="btn btn-primary mb-2 m-2" onclick="window.location.href='/escuderias'">Volver</button>
        </form>
    </div>
    
<%- include ("templates/footer") %>